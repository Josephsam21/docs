  "keyFeatures": [
    "Student medical screening workflow with multi-step form submissions",
    "Medical clearance management and approval system",
    "Supabase-powered authentication with role-based access control",
    "Row Level Security (RLS) for student and staff data isolation",
    "Automated email notifications via Resend Email",
    "Edge Functions for server-side business logic",
    "Real-time status updates using Supabase Realtime",
    "Responsive, accessible UI built with Tailwind CSS",
    "TypeScript-first codebase for end-to-end type safety",
    "Production-ready Next.js 15 App Router architecture"
  ],
  "publicApiSurface": [
